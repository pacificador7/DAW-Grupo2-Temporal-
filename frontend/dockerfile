# =============================================
# ETAPA 1: "builder"
# Node.js para instalar dependencias y compilar React
# Esta etapa NO forma parte de la imagen final
# =============================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copiamos primero package.json y package-lock.json
# Si no cambian, Docker reutiliza la capa de "npm install" (cache)
COPY package.json package-lock.json ./

# Instalamos dependencias (solo de produccion no, necesitamos vite para build)
RUN npm install

# Copiamos el resto del codigo fuente
COPY . .

# Compilamos React -> genera la carpeta dist/
# dist/ contiene HTML, CSS y JS puro que cualquier navegador entiende
RUN npm run build

# =============================================
# ETAPA 2: imagen final
# nginx sirve los archivos estaticos compilados
# Es una imagen muy ligera (~25MB)
# =============================================
FROM nginx:alpine

# Eliminamos la config default de nginx y ponemos la nuestra
# La nuestra incluye el proxy hacia el backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copiamos SOLO la carpeta dist/ generada en la etapa anterior
COPY --from=builder /app/dist /usr/share/nginx/html

# Puerto HTTP estandar
EXPOSE 80

# nginx arranca automaticamente con esta imagen, no hace falta CMD